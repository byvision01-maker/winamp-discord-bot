const { SlashCommandBuilder } = require("discord.js");

const commands = [
  new SlashCommandBuilder()
    .setName("play")
    .setDescription("Добавить музыку в очередь")
    .addStringOption(option =>
      option.setName("song")
        .setDescription("Название композиции или ссылка")
        .setRequired(true)
    ),

  new SlashCommandBuilder()
    .setName("pause")
    .setDescription("Пауза"),

  new SlashCommandBuilder()
    .setName("resume")
    .setDescription("Продолжить"),

  new SlashCommandBuilder()
    .setName("skip")
    .setDescription("Следующий трек"),

  new SlashCommandBuilder()
    .setName("queue")
    .setDescription("Показать очередь"),

  new SlashCommandBuilder()
    .setName("stop")
    .setDescription("Остановить музыку")
];

module.exports = commands.map(command => command.toJSON());